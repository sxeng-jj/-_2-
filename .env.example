# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key

# Pixabay > API 문서 페이지 (https://pixabay.com/api/docs/) 에 로그인하면 보이는 키
# VITE_ 접두사가 없는 값은 브라우저로 노출되지 않고 서버(api/pixabay.ts)에서만 쓰입니다.
PIXABAY_API_KEY=your-pixabay-key

# 제주 역사문화 Open API 키 (공공데이터포털 활용신청 후 발급, 서버 전용)
JEJU_CULTURE_INFO_KEY=제주역사문화일반정보 키
JEJU_CULTURE_LOCATION_KEY=제주역사문화위치정보 키
